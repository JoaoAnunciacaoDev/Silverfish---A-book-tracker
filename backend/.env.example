PORT=8080
ENV=development

# Banco de dados (driver: sqlite ou postgres)
DB_DRIVER=sqlite
DB_SOURCE=silverfish.db

# Chave secreta da sessão (para assinar os cookies)
SESSION_SECRET=mude-esta-chave-secreta-em-producao

# Frontend URL (para liberar no CORS)
FRONTEND_URL=http://localhost:5173

# Chave opcional da Google Books API (recomendada para acervo brasileiro com capas e sinopses em PT-BR)
GOOGLE_BOOKS_API_KEY=INSIRA_AQUI_SUA_CHAVE_DA_GOOGLE_BOOKS_API

# Chaves Web Push (VAPID) para envio de notificações aos navegadores
VAPID_PUBLIC_KEY=Insira_aqui_sua_chave_publica_VAPID
VAPID_PRIVATE_KEY=Insira_aqui_sua_chave_privada_VAPID
VAPID_SUBJECT=mailto:suporte@silverfish.app
